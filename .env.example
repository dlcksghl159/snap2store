OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
AGENT_MODE=auto
AGENT_API_PORT=8788
SMARTSTORE_MODE=live

# 폰 링크 — LAN 폰 카메라용 HTTPS 포트 (자체 서명 인증서 자동 생성)
LINK_HTTPS_PORT=8443
# auto = 부팅 때 cloudflared 인터넷 터널을 미리 연다 — 같은 와이파이 제약·인증서 경고 제거
# (brew install cloudflared 필요. QR 모달의 "인터넷 터널 켜기" 버튼으로도 켤 수 있다)
LINK_TUNNEL=off
# 음성 서기 기본 경로 — 최신 realtime 모델이 발화를 직접 이해해 메모를 정리한다 (텍스트 출력 전용)
VOICE_REALTIME_MODEL=gpt-realtime-2.1
# 자막(입력 전사) 사이드카 + 폴백 경로의 전사 모델
VOICE_TRANSCRIBE_MODEL=gpt-4o-transcribe
VOICE_LANGUAGE=ko
# 폴백(전사+서기 2홉)의 메모 정리 모델 — 비우면 OPENAI_MODEL
VOICE_SCRIBE_MODEL=

# 커머스API — 카테고리·고시·KC·원산지·태그·카탈로그 검색·등록
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
# 커머스API IP 화이트리스트 대응 고정 IP 프록시
COMMERCE_PROXY_URL=

# 검색광고 API — 상품명·태그 검색 수요 검증 (선택)
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=

SMARTSTORE_DEFAULTS_PATH=config/smartstore.local.json
