{
  "name": "snap2store-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "tsx watch server/index.ts",
    "dev:full": "concurrently -k -n agent,ui -c blue,green \"npm:dev:agent\" \"npm:dev\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@openai/agents": "^0.14.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "openai": "^6.49.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.34.5",
    "undici": "^8.9.0",
    "vite": "^6.4.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
